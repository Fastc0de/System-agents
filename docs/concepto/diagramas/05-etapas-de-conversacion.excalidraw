      "boundElements": [],
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Puedes cambiar de modo cuando quieras: «para aquí», «sigue de un tiro», «muéstrame cómo va». En todos los modos se hacen las pruebas de cada fase.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Puedes cambiar de modo cuando quieras: «para aquí», «sigue de un tiro», «muéstrame cómo va». En todos los modos se hacen las pruebas de cada fase.",
      "autoResize": true,
      "lineHeight": 1.25
    },
